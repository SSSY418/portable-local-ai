# 便携 AI 工作台 —— git 忽略规则

# --- 运行时产生的东西 ---
/work/
__pycache__/
*.pyc
*.log
# 体检的磁盘测速缓存（过期自己会重测）
work/disk_speed.json
# koboldcpp 解包出来的运行库（放这里是为了不占系统盘）
/_extract/

# --- 本机/编辑器杂物 ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp

# --- 不进仓库的两大块，用 _tools\install.ps1 下载 ---
# bin\   koboldcpp 程序本体（约 719 MB）。它单个文件就超了 GitHub 的
#        100 MB 限制，走 Git LFS 又会占满免费额度（1 GB 存储 / 1 GB 月流量），
#        所以不进仓库，改成 clone 后让 install.ps1 从官方地址下载
#        （走公共带宽，不占任何人的额度）。
/bin/
# models\ 模型文件（GB 级，且最大的超过 Git LFS 的 2 GB 单文件上限）
/models/
