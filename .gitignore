# 便携 AI 工作台 —— git 忽略规则

# --- 运行时产生的东西 ---
/work/
__pycache__/
*.pyc
*.log
# 体检的磁盘测速缓存（过期自己会重测）
work/disk_speed.json
# koboldcpp 解包出来的运行库（放这里是为了不占系统盘）
/_extract/

# --- 本机/编辑器杂物 ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp

# --- 只排除模型 ---
# py\（便携版 Python，21 MB）和 bin\（koboldcpp，719 MB，走 Git LFS）
# 都在仓库里，clone 下来就能直接跑；只有模型需要你自己准备：
/models/
